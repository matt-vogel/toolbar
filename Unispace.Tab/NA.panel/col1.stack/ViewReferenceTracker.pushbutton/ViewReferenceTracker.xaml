<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="View Reference Tracker"
        Height="650" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Main Content -->
            <RowDefinition Height="Auto"/>
            <!-- Button Bar -->
            <RowDefinition Height="25"/>
            <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ======================================== TOOLBAR ======================================== -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Refresh Button -->
                <Button x:Name="btn_refresh"
                        Content="🔄 Refresh"
                        Grid.Column="0"
                        Width="100"
                        Height="25"
                        Margin="0,0,15,0"
                        Click="refresh_click"/>

                <!-- View Type Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Show:" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <CheckBox x:Name="chk_floor_plans" Content="Floor Plans" IsChecked="True" Margin="0,0,10,0" Checked="filter_changed" Unchecked="filter_changed"/>
                    <CheckBox x:Name="chk_sections" Content="Sections" IsChecked="True" Margin="0,0,10,0" Checked="filter_changed" Unchecked="filter_changed"/>
                    <CheckBox x:Name="chk_elevations" Content="Elevations" IsChecked="True" Margin="0,0,10,0" Checked="filter_changed" Unchecked="filter_changed"/>
                    <CheckBox x:Name="chk_drafting" Content="Drafting" IsChecked="True" Margin="0,0,10,0" Checked="filter_changed" Unchecked="filter_changed"/>
                    <CheckBox x:Name="chk_3d" Content="3D Views" IsChecked="True" Margin="0,0,10,0" Checked="filter_changed" Unchecked="filter_changed"/>
                    <CheckBox x:Name="chk_templates" Content="Templates" IsChecked="False" Margin="0,0,10,0" Checked="filter_changed" Unchecked="filter_changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================== MAIN CONTENT ======================================== -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - TreeView -->
            <GroupBox Grid.Column="0" Header="Sheets and Views" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Main Tree -->
                    <TreeView x:Name="tree_sheets"
                              Grid.Row="0"
                              Background="White"
                              BorderThickness="0"
                              SelectedItemChanged="tree_selection_changed">
                    </TreeView>

                    <!-- Unreferenced Views Section (Collapsible) -->
                    <Expander x:Name="expander_unreferenced"
                              Grid.Row="1"
                              Header="Unreferenced Views"
                              IsExpanded="False"
                              Margin="0,10,0,0">
                        <TreeView x:Name="tree_unreferenced"
                                  Background="White"
                                  BorderThickness="0"
                                  MaxHeight="200"
                                  Margin="5"
                                  SelectedItemChanged="tree_selection_changed">
                        </TreeView>
                    </Expander>

                    <!-- Loading Overlay for Left Panel -->
                    <Border x:Name="loading_overlay_left"
                            Background="#CCFFFFFF"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏳ Loading..."
                                       Foreground="Black"
                                       FontSize="16"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="#CCCCCC"
                          ShowsPreview="True"/>

            <!-- Right Panel - Details -->
            <GroupBox Grid.Column="2" Header="Reference Details" Padding="5">
                <Grid>
                    <!-- Details Content -->
                    <ScrollViewer x:Name="scroll_details" VerticalScrollBarVisibility="Auto" Focusable="True">
                        <StackPanel x:Name="panel_details" Margin="5">
                            <TextBlock Text="Select a view to see reference details"
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,20,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Loading Overlay for Right Panel -->
                    <Border x:Name="loading_overlay_right"
                            Background="#CCFFFFFF"
                            Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⏳ Loading references..."
                                       Foreground="Black"
                                       FontSize="16"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ======================================== BUTTON BAR ======================================== -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close"
                        Width="80"
                        Height="25"
                        Click="button_close"
                        IsCancel="True"/>
            </StackPanel>
        </Border>

        <!-- ======================================== STATUS BAR ======================================== -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="status_text"
                       Text="Ready"
                       Foreground="Black"
                       Margin="10,3,10,3"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
